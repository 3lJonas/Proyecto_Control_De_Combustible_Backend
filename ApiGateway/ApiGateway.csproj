<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>



  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.33.1" />
    <PackageReference Include="Grpc" Version="2.46.6" />
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.15" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	  <Protobuf Include="Protos\Choferes.proto" GrpcServices="Server" />
	  <Protobuf Include="Protos\Usuarios.proto" GrpcServices="Client" />
	  <Protobuf Include="Protos\vehiculo.proto" GrpcServices="Client" />
	  <Protobuf Include="Protos\Choferes.proto" GrpcServices="Client" />
	  <Protobuf Include="Protos\AsignacionRutas.proto" GrpcServices="Client" />
	  <Protobuf Include="Protos\Rutas.proto" GrpcServices="Client" />
	  <Protobuf Include="Protos\ConsumoCombustibles.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
